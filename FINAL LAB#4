package com.example.sqlitenotesapp

import android.os.Bundle
import android.widget.ArrayAdapter
import android.widget.Button
import android.widget.EditText
import android.widget.ListView
import android.widget.Toast
import androidx.appcompat.app.AlertDialog
import androidx.appcompat.app.AppCompatActivity

class MainActivity : AppCompatActivity() {

    // Use 'lateinit' for non-nullable properties initialized in onCreate
    private lateinit var dbHelper: DatabaseHelper
    private lateinit var etTitle: EditText
    private lateinit var etContent: EditText
    private lateinit var btnSave: Button
    private lateinit var listNotes: ListView
    private lateinit var notesAdapter: ArrayAdapter<String>
    private var notesWithIds: List<Pair<Int, String>> = listOf()

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        // Initialize views
        etTitle = findViewById(R.id.et_title)
        etContent = findViewById(R.id.et_content)
        btnSave = findViewById(R.id.btn_save)
        listNotes = findViewById(R.id.list_notes)

        dbHelper = DatabaseHelper(this)

        // Set listeners
        btnSave.setOnClickListener { saveNote() }

        // Long-click listener for deleting notes (Part IV)
        listNotes.setOnItemLongClickListener { _, _, position, _ ->
            val selectedNoteId = notesWithIds[position].first
            showDeleteConfirmationDialog(selectedNoteId)
            true // Return true to indicate the event was handled
        }

        loadNotes()
    }

    private fun saveNote() {
        val title = etTitle.text.toString().trim()
        val content = etContent.text.toString().trim()

        if (title.isEmpty()) {
            Toast.makeText(this, "Please enter a title", Toast.LENGTH_SHORT).show()
            return
        }

        val id = dbHelper.insertNote(title, content)
        if (id != -1L) {
            Toast.makeText(this, "Note saved!", Toast.LENGTH_SHORT).show()
            etTitle.text.clear()
            etContent.text.clear()
            loadNotes() // Refresh the list
        } else {
            Toast.makeText(this, "Failed to save note", Toast.LENGTH_SHORT).show()
        }
    }

    private fun loadNotes() {
        notesWithIds = dbHelper.getAllNotes()
        val noteStrings = notesWithIds.map { it.second } // Get only the string part for display
        notesAdapter = ArrayAdapter(this, android.R.layout.simple_list_item_1, noteStrings)
        listNotes.adapter = notesAdapter
    }
    
    private fun showDeleteConfirmationDialog(noteId: Int) {
        AlertDialog.Builder(this)
            .setTitle("Delete Note")
            .setMessage("Are you sure you want to delete this note?")
            .setPositiveButton("Delete") { _, _ ->
                // User clicked Delete button
                deleteNoteAndRefresh(noteId)
            }
            .setNegativeButton("Cancel", null) // Do nothing on cancel
            .show()
    }

    private fun deleteNoteAndRefresh(noteId: Int) {
        val deletedRows = dbHelper.deleteNote(noteId)
        if (deletedRows > 0) {
            Toast.makeText(this, "Note deleted", Toast.LENGTH_SHORT).show()
            loadNotes() // Refresh the list to show the change
        } else {
            Toast.makeText(this, "Error deleting note", Toast.LENGTH_SHORT).show()
        }
    }
}
